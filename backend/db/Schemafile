# ridgepole のスキーマ定義。**DB の唯一の正はこのファイル**。ここに無いテーブルは db:apply で削除される (--drop-table)。
# 変更したら `make db-apply` (中身は ridgepole --apply) で DB に反映する。
# マイグレーションファイルは作らない。

# プロフィール。認証情報は持たない
create_table "users", force: :cascade do |t|
  t.string "name", null: false
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false
end

# 認証情報。email / パスワードは devise が、jti は devise-jwt が使う。
# 将来 OAuth を足す場合も provider 列を増やしてこのテーブルに寄せる
create_table "identities", force: :cascade do |t|
  t.references "user", null: false, foreign_key: true
  t.string "email", null: false
  t.string "encrypted_password", null: false, default: ""
  t.string "jti", null: false
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "email" ], name: "index_identities_on_email", unique: true
  t.index [ "jti" ], name: "index_identities_on_jti", unique: true
end

# 部屋。写真の解析結果 (シーン) を jsonb で持つ。形は swagger の Scene
create_table "rooms", force: :cascade do |t|
  # Legacy anonymous rooms remain unassigned and are not exposed by authenticated APIs.
  t.references "user", null: true, foreign_key: true
  t.decimal "tatami", precision: 4, scale: 1, null: false
  t.string "shape", null: false, default: "standard" # 既存行の補完用。API では必須 (Room モデル参照)
  t.string "status", null: false, default: "analyzing"
  t.jsonb "scene"
  # GCS 上の部屋写真の key。バケット名は設定なので入れない (Storage 参照)
  t.jsonb "photo_keys", null: false, default: []
  t.string "analyzed_by" # gemini: 写真を AI で解析 / mock: 畳数と部屋の形から作ったモック
  t.jsonb "analysis" # 精度の確認用: 解析の生の回答・モデル・時間・トークン数・家具の置き方 (API には出さない)
  t.text "error_message"
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false
end

# コーデ提案。採用した商品と配置後のシーンを jsonb で持つ
create_table "coordinations", force: :cascade do |t|
  t.references "room", null: false, foreign_key: true
  t.text "prompt", null: false
  t.integer "budget"
  t.jsonb "kept_object_ids", null: false, default: []
  t.jsonb "edited_objects", null: false, default: []
  t.jsonb "furniture_operations", null: false, default: []
  t.jsonb "additions", null: false, default: []
  # 追加の指示で作り直すときの前回のコーデ (同じ部屋)。前回の商品を引き継ぐのに使う
  t.bigint "base_coordination_id"
  t.string "status", null: false, default: "pending"
  t.string "title"
  t.text "comment"
  t.jsonb "after_scene"
  t.jsonb "items", null: false, default: []
  t.integer "total_price"
  t.string "planned_by" # gemini: 要望文から AI が商品を選んだ / mock: キーワードでテーマを決めたモック
  t.jsonb "analysis" # 精度の確認用: Gemini の回答・モデル・時間・トークン数・採用した商品 (API には出さない)
  t.text "error_message"
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false
end

# 家具。detail (色・寸法・購入リンク) が指す。3D モデルは furniture_3d_models (1 : 1)。
# db/furnitures.json から rails furniture:import で入れる
create_table "furnitures", force: :cascade do |t|
  t.string "name", null: false # 表示名 (例: 2人掛けソファ)
  t.string "category", null: false # 家具の種類 (sofa, chair, rug など)。推し活グッズはグッズ種別 (acrylic_stand など、config/goods_categories.json)
  t.boolean "enabled", null: false, default: true # false なら使わない (API・提案から外す)
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false
end

# 家具の 3D モデル (GLB)。GLB 本体は GCS の models/furniture/v1/<model_key>.glb
create_table "furniture_3d_models", force: :cascade do |t|
  t.references "furniture", null: false, foreign_key: true, index: { unique: true }
  t.string "model_key", null: false # モデルの安定 ID。GLB のファイル名 (例: sofa_2seat__w130)。家具を指すキーにも使う
  t.string "shape", null: false # 形の種類 (sofa_2seat, rug_round など)。同じ形の寸法違いで共通
  t.string "variant" # 同じ形の中の違い (w130 など)。無ければ null
  t.string "format", null: false, default: "glb" # ファイル形式。glb のみ
  t.decimal "width", precision: 10, scale: 6, null: false # モデルの幅 (m)
  t.decimal "height", precision: 10, scale: 6, null: false # モデルの高さ (m)
  t.decimal "depth", precision: 10, scale: 6, null: false # モデルの奥行き (m)
  t.integer "triangle_count", null: false # ポリゴン数
  t.bigint "byte_size", null: false # GLB のバイト数
  t.string "sha256", null: false # GLB のハッシュ。ファイルとの照合用
  t.jsonb "color_material_keys", null: false, default: [] # 色が分かれている部位の名前 (GLB の素材名。例: ["tint", "wood"])
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "model_key" ], unique: true
  t.check_constraint "width > 0::numeric AND width < 10000::numeric AND height > 0::numeric AND height < 10000::numeric AND depth > 0::numeric AND depth < 10000::numeric", name: "furniture_3d_models_positive_dimensions"
  t.check_constraint "triangle_count >= 0 AND byte_size > 0", name: "furniture_3d_models_valid_counts"
  t.check_constraint "format::text = 'glb'::text", name: "furniture_3d_models_glb_format"
end

# 家具の色・寸法・購入リンク 1 つ (家具 1 : 多)。3D は家具のモデルを部位ごとに color_materials で塗る。価格はリンク先の参考価格 (税込)。
# db/furniture_details.json から rails furniture_detail:import で入れる
create_table "furniture_details", force: :cascade do |t|
  t.string "key", null: false
  t.references "furniture", null: false, foreign_key: true
  t.string "name", null: false
  t.string "category", null: false
  t.string "slot", null: false
  t.string "symbolic_color", null: false # 代表色 (#rrggbb)。モデルが無いときの表示・色での検索・AI への商品情報に使う
  t.jsonb "color_materials", null: false, default: {} # 部位ごとの色 (例: {"tint": "#123682", "wood": "#714248"})。キーは家具の color_material_keys。無い部位はモデルの色のまま
  t.string "color_name" # 公式の色名
  t.decimal "width", precision: 10, scale: 6, null: false
  t.decimal "height", precision: 10, scale: 6, null: false
  t.decimal "depth", precision: 10, scale: 6, null: false
  t.integer "price", null: false
  t.string "shop", null: false
  t.string "url", null: false
  t.string "image_url"
  t.jsonb "themes", null: false, default: []
  t.jsonb "metadata", null: false, default: {} # 出典・推定した寸法の軸など
  t.integer "position", null: false, default: 0 # 候補の並び順 (小さいほど先)。AI は枠ごとに先頭から一定数だけ見る
  t.datetime "checked_at"
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "key" ], unique: true
  t.index [ "slot", "position" ]
  t.check_constraint "price > 0", name: "furniture_details_positive_price"
  t.check_constraint "width > 0::numeric AND height > 0::numeric AND depth > 0::numeric", name: "furniture_details_positive_dimensions"
end

# 模様 (質感の画像)。静的に用意し、db/furniture_textures.json から rails furniture_texture:import で入れる
create_table "furniture_textures", force: :cascade do |t|
  t.string "texture_key", null: false # 安定 ID (例: linen)。画像は textures/v1/<texture_key>.png
  t.string "name", null: false # 表示名 (例: リネン)
  t.decimal "tile_size_m", precision: 6, scale: 3, null: false # 画像 1 枚が何 m 四方か
  t.boolean "tinted", null: false, default: true # true: 部位の色を掛ける (色の無い質感画像) / false: 柄物なので画像の色のまま
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "texture_key" ], unique: true
  t.check_constraint "tile_size_m > 0::numeric", name: "furniture_textures_positive_tile_size"
end

# detail の部位に貼る模様 (detail 1 : 0〜n)
create_table "furniture_detail_textures", force: :cascade do |t|
  t.references "furniture_detail", null: false, foreign_key: true
  t.references "furniture_texture", null: false, foreign_key: true
  t.string "material_key", null: false # 貼る部位 (家具の color_material_keys のどれか)
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "furniture_detail_id", "material_key" ], unique: true
end

# 作品・事務所 (ピアプロ、ホロライブなど)。db/characters.json から rails character:import で入れる
create_table "franchises", force: :cascade do |t|
  t.string "franchise_key", null: false # 安定 ID (例: piapro)
  t.string "name", null: false
  t.jsonb "aliases", null: false, default: [] # 検索の別名 ([{text, ambiguous}])
  t.string "license" # ライセンスの種類
  t.string "license_url" # 利用ガイドライン
  t.string "credit" # 表示するクレジット
  t.text "notice" # 表示する注意書き
  t.boolean "likeness_allowed", null: false, default: false # キャラクターの 3D モデルを作ってよいか
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "franchise_key" ], unique: true
end

# キャラクター。db/characters.json から rails character:import で入れる
create_table "characters", force: :cascade do |t|
  t.string "character_key", null: false # 安定 ID (例: hatsune_miku)
  t.references "franchise", null: false, foreign_key: true
  t.string "name", null: false
  t.string "name_en"
  t.string "group" # ユニット・グループ名
  t.string "status", null: false, default: "active" # 活動状況
  t.string "color" # イメージカラー (#rrggbb)
  t.string "color_source" # color の出典 (official / community)
  t.string "theme_id" # キャラクターテーマ (config/character_themes.json) の ID
  t.jsonb "aliases", null: false, default: [] # 検索の別名 ([{text, ambiguous}])。ambiguous は手掛かりの語があるときだけ使う
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "character_key" ], unique: true
end

# キャラクターと、そのキャラクターのグッズである家具 (多対多)。db/furnitures.json の characters から rails furniture:import で作る
create_table "character_goods", force: :cascade do |t|
  t.references "character", null: false, foreign_key: true
  t.references "furniture", null: false, foreign_key: true
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "character_id", "furniture_id" ], unique: true
end
