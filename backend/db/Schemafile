# ridgepole のスキーマ定義。**DB の唯一の正はこのファイル**。
# 変更したら `make db-apply` (中身は ridgepole --apply) で DB に反映する。
# マイグレーションファイルは作らない。

# プロフィール。認証情報は持たない
create_table "users", force: :cascade do |t|
  t.string "name", null: false
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false
end

# 認証情報。email / パスワードは devise が、jti は devise-jwt が使う。
# 将来 OAuth を足す場合も provider 列を増やしてこのテーブルに寄せる
create_table "identities", force: :cascade do |t|
  t.references "user", null: false, foreign_key: true
  t.string "email", null: false
  t.string "encrypted_password", null: false, default: ""
  t.string "jti", null: false
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "email" ], name: "index_identities_on_email", unique: true
  t.index [ "jti" ], name: "index_identities_on_jti", unique: true
end

# 部屋。写真の解析結果 (シーン) を jsonb で持つ。形は swagger の Scene
create_table "rooms", force: :cascade do |t|
  # Legacy anonymous rooms remain unassigned and are not exposed by authenticated APIs.
  t.references "user", null: true, foreign_key: true
  t.decimal "tatami", precision: 4, scale: 1, null: false
  t.string "shape", null: false, default: "standard" # 既存行の補完用。API では必須 (Room モデル参照)
  t.string "status", null: false, default: "analyzing"
  t.jsonb "scene"
  # GCS 上の部屋写真の key。バケット名は設定なので入れない (Storage 参照)
  t.jsonb "photo_keys", null: false, default: []
  t.string "analyzed_by" # gemini: 写真を AI で解析 / mock: 畳数と部屋の形から作ったモック
  t.jsonb "analysis" # 精度の確認用: 解析の生の回答・モデル・時間・トークン数・家具の置き方 (API には出さない)
  t.text "error_message"
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false
end

# コーデ提案。採用した商品と配置後のシーンを jsonb で持つ
create_table "coordinations", force: :cascade do |t|
  t.references "room", null: false, foreign_key: true
  t.text "prompt", null: false
  t.integer "budget", null: false
  t.jsonb "kept_object_ids", null: false, default: []
  t.jsonb "edited_objects", null: false, default: []
  t.jsonb "furniture_operations", null: false, default: []
  t.jsonb "additions", null: false, default: []
  # 追加の指示で作り直すときの前回のコーデ (同じ部屋)。前回の商品を引き継ぐのに使う
  t.bigint "base_coordination_id"
  t.string "status", null: false, default: "pending"
  t.string "title"
  t.text "comment"
  t.jsonb "after_scene"
  t.jsonb "items", null: false, default: []
  t.integer "total_price"
  t.string "planned_by" # gemini: 要望文から AI が商品を選んだ / mock: キーワードでテーマを決めたモック
  t.jsonb "analysis" # 精度の確認用: Gemini の回答・モデル・時間・トークン数・採用した商品 (API には出さない)
  t.text "error_message"
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false
end

# 公式ECで確認した商品・バリエーションの安定した内部IDと取得情報を保存する
create_table "ec_products", force: :cascade do |t|
  t.string "provider", null: false
  t.string "provider_product_id", null: false
  t.string "variant_id", null: false
  t.string "source_url", null: false
  t.jsonb "data", null: false, default: {}
  t.datetime "fetched_at", null: false
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "provider", "provider_product_id", "variant_id" ], unique: true, name: "index_ec_products_on_identity"
end

# 旧: 3D モデルの台帳。furnitures へ置き換えた。デプロイ後に保存済みデータを確認してから削除する
create_table "furniture_models", force: :cascade do |t|
  t.string "key", null: false
  t.string "name", null: false
  t.string "category", null: false
  t.string "shape", null: false
  t.string "variant"
  t.string "format", null: false, default: "glb"
  t.string "object_key", null: false
  t.decimal "width", precision: 10, scale: 6, null: false
  t.decimal "height", precision: 10, scale: 6, null: false
  t.decimal "depth", precision: 10, scale: 6, null: false
  t.integer "triangle_count", null: false
  t.bigint "byte_size", null: false
  t.string "sha256", null: false
  t.jsonb "materials", null: false, default: []
  t.boolean "enabled", null: false, default: true
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "key" ], unique: true
  t.check_constraint "width > 0::numeric AND width < 10000::numeric AND height > 0::numeric AND height < 10000::numeric AND depth > 0::numeric AND depth < 10000::numeric", name: "furniture_models_positive_dimensions"
  t.check_constraint "triangle_count >= 0 AND byte_size > 0", name: "furniture_models_valid_counts"
  t.check_constraint "format::text = 'glb'::text", name: "furniture_models_glb_format"
end

# 旧: furniture_bindings へ置き換えた。furniture_models と一緒に削除する
create_table "furniture_model_bindings", force: :cascade do |t|
  t.references "furniture_model", null: false, foreign_key: true
  t.string "kind", null: false
  t.string "reference", null: false
  t.string "managed_by", null: false, default: "manifest"
  t.jsonb "match_metadata", null: false, default: {}
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "kind", "reference" ], unique: true
  t.check_constraint "kind::text = ANY (ARRAY['existing'::character varying::text, 'product'::character varying::text])", name: "furniture_model_bindings_valid_kind"
end

# Description-derived images are immutable and shared by their complete generation key.
create_table "furniture_textures", force: :cascade do |t|
  t.string "generation_key", null: false
  t.string "bucket", null: false
  t.string "object_key", null: false
  t.string "generator_model", null: false
  t.string "material_name", null: false
  t.text "source_description", null: false
  t.decimal "tile_size_m", precision: 6, scale: 3, null: false
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false
  t.index [ "generation_key" ], unique: true
end

# 家具 1 件 = 3D モデル 1 つ。GLB 本体は GCS に置き、DB には検索・描画に必要なメタデータを持つ。
# 中身は db/furnitures.json を正とし、rails furniture:import で取り込む
create_table "furnitures", force: :cascade do |t|
  t.string "key", null: false
  t.string "name", null: false
  t.string "category", null: false
  t.string "shape", null: false
  t.string "variant"
  t.string "format", null: false, default: "glb"
  t.string "object_key", null: false
  t.decimal "width", precision: 10, scale: 6, null: false
  t.decimal "height", precision: 10, scale: 6, null: false
  t.decimal "depth", precision: 10, scale: 6, null: false
  t.integer "triangle_count", null: false
  t.bigint "byte_size", null: false
  t.string "sha256", null: false
  t.jsonb "materials", null: false, default: []
  t.boolean "enabled", null: false, default: true
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "key" ], unique: true
  t.check_constraint "width > 0::numeric AND width < 10000::numeric AND height > 0::numeric AND height < 10000::numeric AND depth > 0::numeric AND depth < 10000::numeric", name: "furnitures_positive_dimensions"
  t.check_constraint "triangle_count >= 0 AND byte_size > 0", name: "furnitures_valid_counts"
  t.check_constraint "format::text = 'glb'::text", name: "furnitures_glb_format"
end

# 写真で認識した家具 ID (existing) / 保存済みコーデの商品 ID (product) を家具のモデルに対応させる
create_table "furniture_bindings", force: :cascade do |t|
  t.references "furniture", null: false, foreign_key: true
  t.string "kind", null: false
  t.string "reference", null: false
  t.string "managed_by", null: false, default: "manifest"
  t.jsonb "match_metadata", null: false, default: {}
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "kind", "reference" ], unique: true
  t.check_constraint "kind::text = ANY (ARRAY['existing'::character varying::text, 'product'::character varying::text])", name: "furniture_bindings_valid_kind"
end

# 家具の色・寸法・購入リンク 1 つ (家具 1 : 多)。3D は家具のモデルの形を使い、color で塗る。
# 中身は db/furniture_details.json を正とし、rails furniture_detail:import で取り込む (自動EC検索はしない)。価格はリンク先の参考価格 (税込)
create_table "furniture_details", force: :cascade do |t|
  t.string "key", null: false
  t.references "furniture", null: false, foreign_key: true
  t.string "name", null: false
  t.string "category", null: false
  t.string "slot", null: false
  t.string "color", null: false
  t.string "color_name"
  t.decimal "width", precision: 10, scale: 6, null: false
  t.decimal "height", precision: 10, scale: 6, null: false
  t.decimal "depth", precision: 10, scale: 6, null: false
  t.integer "price", null: false
  t.string "shop", null: false
  t.string "url", null: false
  t.string "image_url"
  t.jsonb "themes", null: false, default: []
  t.jsonb "metadata", null: false, default: {} # 出典・推定した軸など。ECで確認した商品は確認時の記録を残す
  t.integer "position", null: false, default: 0 # 候補の並び順 (小さいほど先)。AI は枠ごとに先頭から一定数だけ見る
  t.datetime "checked_at"
  t.datetime "created_at", null: false
  t.datetime "updated_at", null: false

  t.index [ "key" ], unique: true
  t.index [ "slot", "position" ]
  t.check_constraint "price > 0", name: "furniture_details_positive_price"
  t.check_constraint "width > 0::numeric AND height > 0::numeric AND depth > 0::numeric", name: "furniture_details_positive_dimensions"
end
