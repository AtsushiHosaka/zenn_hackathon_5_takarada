DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
RAILS_ENV=development

# Both documents must be configured to enable POST /api/v1/signup; login remains available.
# URI-encoded ASCII HTTPS URLs or root-relative paths only (valid %HH escapes).
# Encode non-ASCII paths and use punycode hosts; raw embedded spaces are invalid.
# Compose reads these from the root .env,
# shared with the frontend; direct Rails startup reads its process environment.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# 未設定なら Rails の secret_key_base が使われる。本番では必ず指定する
DEVISE_JWT_SECRET_KEY=

# Gemini。GCP 課金は vertex、手元で従来の API キーを使う場合は developer。
# Vertex は ADC が必要。Docker では ADC ファイルを読み取り専用で api/worker に渡す。
# 認証に失敗しても API キーへ切り替えない。
# ローカルで vertex (Gemini Enterprise Agent Platform) を使う手順:
#   1. gcloud をインストールし、`gcloud auth application-default login` でログインする
#   2. `gcloud auth application-default set-quota-project zenn-hackathon-takarada`
#   3. 自分の Google アカウントに、プロジェクトの roles/aiplatform.user を付けてもらう
#   4. ここを GEMINI_PROVIDER=vertex・GOOGLE_CLOUD_PROJECT=zenn-hackathon-takarada にして、api と worker を作り直す
#   compose.override.yaml が ~/.config/gcloud をコンテナへ読み取り専用で渡す (別の場所なら GCLOUD_CONFIG_DIR で指定)
GEMINI_PROVIDER=developer
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# developer の場合だけ使用する。Vertex に設定するキーは不要。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 考える量 (low / medium / high)。空ならモデルの既定。low にすると速く安くなる
GEMINI_THINKING_LEVEL=
# 限定検証ではroom owner IDをカンマ区切り。空は全員mock、*は一般AI利用を明示許可。
# 未指定は設定済みの接続先で全ownerがAIを使う。空文字を明示すると全員mock。
# GEMINI_ALLOWED_USER_IDS=123

# 家具GLBの公開GCSバケット。部屋写真のバケットとは分ける。
MODELS_BUCKET=

# 公開GLBの配信元。省略時はMODELS_BUCKETを使う。例: https://storage.googleapis.com/your-bucket
# object_keyをこのURLへ追加する。両方未設定なら簡易形状を表示する。
# docker composeではMODELS_BUCKETとともにリポジトリ直下の.envへ設定する。
FURNITURE_MODEL_BASE_URL=

# EC_PROVIDER未指定はGeminiのowner利用許可・認証があればlive、それ以外はmock。
# liveを明示して認証不足なら失敗を返す。公式詳細HTMLの価格・寸法を検証する。
# EC_PROVIDER=live
EC_SEARCH_MODEL=gemini-3.5-flash
# 構造化情報が不足した商品HTMLの抽出。未設定はFlash-Lite。
EC_EXTRACTION_MODEL=gemini-3.1-flash-lite
# 商品画像は入力せず、色・素材の説明から最大3枚/提案を生成する。
# falseで生成のみ停止。モデル照合と商品表示は維持する。
FURNITURE_TEXTURES_ENABLED=true
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_LOCATION=global
# ローカル生成画像の配信元。外部公開URLやポートを変える場合に設定する。
DEV_API_ORIGIN=http://localhost:3000
