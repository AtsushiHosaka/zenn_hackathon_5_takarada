DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
RAILS_ENV=development

# 未設定なら Rails の secret_key_base が使われる。本番では必ず指定する
DEVISE_JWT_SECRET_KEY=

# Gemini (部屋の写真の解析)。https://aistudio.google.com/apikey で各自発行し、backend/.env に書く。
# 未設定なら写真を解析せず、畳数と部屋の形から作るモックで動く
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
