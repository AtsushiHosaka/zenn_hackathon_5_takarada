DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
RAILS_ENV=development

# 未設定なら Rails の secret_key_base が使われる。本番では必ず指定する
DEVISE_JWT_SECRET_KEY=

# Gemini。GCP 課金は vertex、手元で従来の API キーを使う場合は developer。
# Vertex は ADC が必要。Docker では ADC ファイルを読み取り専用で api/worker に渡す。
# 認証に失敗しても API キーへ切り替えない。
GEMINI_PROVIDER=developer
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# developer の場合だけ使用する。Vertex に設定するキーは不要。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 考える量 (low / medium / high)。空ならモデルの既定。low にすると速く安くなる
GEMINI_THINKING_LEVEL=
# 限定検証ではroom owner IDをカンマ区切り。空は全員mock、*は一般AI利用を明示許可。
# 未指定は設定済みの接続先で全ownerがAIを使う。空文字を明示すると全員mock。
# GEMINI_ALLOWED_USER_IDS=123

# 家具GLBの公開GCSバケット。部屋写真のバケットとは分ける。
MODELS_BUCKET=

# 公開GLBの配信元。省略時はMODELS_BUCKETを使う。例: https://storage.googleapis.com/your-bucket
# object_keyをこのURLへ追加する。両方未設定なら簡易形状を表示する。
# docker composeではMODELS_BUCKETとともにリポジトリ直下の.envへ設定する。
FURNITURE_MODEL_BASE_URL=
