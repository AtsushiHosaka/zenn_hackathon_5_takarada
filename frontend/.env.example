# Vite は VITE_ で始まる変数だけをバンドルに埋め込む。**秘密は書かない**
# (ブラウザから丸見えになる)。

# 実 API を叩くときの接続先。デプロイ済みなら `make infra-url` の値
VITE_API_ENDPOINT=https://407mdoxgib.execute-api.ap-northeast-1.amazonaws.com

# 開発時の接続先: dummy (backend 不要) | api
# 空欄なら開発時は dummy。本番ビルドはこの値によらず api。
VITE_CONNECTION=

# analysis: mainの部屋解析モックAPI。JSONで畳数と形を送る。
# coordination: mainの部屋解析→商品提案の2段階モックAPI。
# legacy: 将来API向け提案形式。写真multipartと独自応答形式。
VITE_ROOM_API_CONTRACT=coordination
# analysis/coordinationで未設定なら以下のパスを使う。
VITE_ROOM_GENERATION_PATH=/api/v1/rooms
VITE_ROOM_JOB_PATH=/api/v1/rooms/{id}
VITE_ROOM_COORDINATION_PATH=/api/v1/rooms/{id}/coordinations
VITE_ROOM_COORDINATION_JOB_PATH=/api/v1/coordinations/{id}
# 写真のアップロード先を発行する。空なら写真を送らない
VITE_ROOM_UPLOADS_PATH=/api/v1/uploads
# mainの部屋解析モックAPIは公開エンドポイント。
VITE_ROOM_REQUIRES_AUTH=false

# legacyの場合のmultipart/form-dataフィールド名。
VITE_ROOM_PHOTO_FIELD=photos[]
VITE_ROOM_PROMPT_FIELD=prompt
VITE_ROOM_STYLE_FIELD=style
VITE_ROOM_BUDGET_FIELD=budget
